<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <script src="https://tailwindcss.com"></script>
</head>
<body class="bg-slate-50 font-sans antialiased text-slate-800">

  <!-- Top Navbar -->
  <nav class="bg-slate-900 border-b border-slate-800 text-white shadow-sm sticky top-0 z-50">
    <div class="container mx-auto px-4 py-4 flex justify-between items-center">
      <div class="flex items-center space-x-2">
        <span class="text-2xl">🏗️</span>
        <h1 class="text-xl font-extrabold tracking-tight bg-gradient-to-r from-amber-400 to-orange-500 bg-clip-text text-transparent">Toko Seni Gypsum</h1>
      </div>
      <div class="flex space-x-3">
        <a href="/api/status" target="_blank" class="text-xs bg-slate-800 hover:bg-slate-700 text-slate-200 font-medium px-3 py-2 rounded-md transition border border-slate-700">API Status</a>
        <a href="/api/produk" target="_blank" class="text-xs bg-amber-500 hover:bg-amber-600 text-slate-900 font-semibold px-3 py-2 rounded-md transition">API Produk</a>
      </div>
    </div>
  </nav>

  <!-- Hero Section & Shop Info -->
  <header class="bg-slate-900 text-white pb-24 pt-12 px-4 border-b border-slate-800">
    <div class="container mx-auto max-w-6xl grid grid-cols-1 md:grid-cols-3 gap-6">
      <div class="md:col-span-2">
        <span class="text-amber-400 font-bold tracking-widest text-xs uppercase">Sistem Portal Digital - V2.0</span>
        <h2 class="text-3xl md:text-4xl font-black mt-2 leading-tight">Solusi Kebutuhan Plafon & Transaksi Efisien</h2>
        <p class="text-slate-400 mt-4 max-w-xl text-sm leading-relaxed">Penyediaan informasi katalog produk secara mandiri dan transparan guna mendukung percepatan operasional layanan kontraktor maupun retail.</p>
      </div>
      <div class="bg-slate-800/60 p-5 rounded-xl border border-slate-700/50 backdrop-blur text-xs space-y-3">
        <h4 class="font-bold text-amber-400 text-sm border-b border-slate-700 pb-2">📍 Informasi Toko Fisik</h4>
        <p><strong class="text-white">Alamat:</strong> <%= shopInfo.address %></p>
        <p><strong class="text-white">Operasional:</strong> <%= shopInfo.hours %></p>
        <p><strong class="text-white">Estimasi Pemasangan:</strong> <br><span class="text-slate-300"><%= shopInfo.installationPrice %></span></p>
      </div>
    </div>
  </header>

  <!-- Main Container -->
  <main class="container mx-auto max-w-6xl px-4 -mt-12 mb-16">
    <!-- Section: Catalog -->
    <div class="bg-white rounded-2xl shadow-xl border border-slate-200/80 p-6 md:p-8">
      <div class="sm:flex justify-between items-center mb-6">
        <div>
          <h3 class="text-xl font-bold text-slate-900">Katalog Utama Produk</h3>
          <p class="text-xs text-slate-500 mt-1">Data real-time yang bersumber dari array statis model backend</p>
        </div>
        <span class="mt-2 sm:mt-0 inline-flex items-center rounded-full bg-emerald-50 px-2.5 py-1 text-xs font-medium text-emerald-700 border border-emerald-200">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 mr-1.5"></span> Terhubung Aktif
        </span>
      </div>

      <!-- Grid Cards -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        <% if (products.length > 0) { %>
          <% products.forEach(product => { %>
            <div class="group bg-white rounded-xl border border-slate-200 hover:border-amber-400 transition-all duration-200 p-5 flex flex-col justify-between hover:shadow-md">
              <div>
                <div class="flex justify-between items-start mb-3">
                  <span class="bg-slate-100 text-slate-700 text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded">
                    <%= product.category %>
                  </span>
                  <span class="text-slate-300 text-xs">ID: #0<%= product.id %></span>
                </div>
                <h4 class="text-base font-bold text-slate-900 group-hover:text-amber-600 transition-colors"><%= product.name %></h4>
                <p class="text-xs text-slate-500 mt-1.5 leading-relaxed"><%= product.spec %></p>
              </div>
              <div class="mt-5 pt-3 border-t border-slate-100 flex items-center justify-between">
                <div>
                  <span class="text-[10px] text-slate-400 block uppercase font-medium">Harga Grosir/Ecer</span>
                  <!-- MENJADI -->
                <span class="text-base font-extrabold text-slate-900"><%= formatRupiah(product.price) %></span>
                </div>
                <a href="/api/produk" class="text-xs bg-slate-100 hover:bg-amber-500 hover:text-slate-900 text-slate-700 font-semibold px-3 py-2 rounded-md transition-colors">
                  Detail Proyek
                </a>
              </div>
            </div>
          <% }) %>
        <% } else { %>
          <div class="col-span-full text-center py-12 border-2 border-dashed border-slate-200 rounded-xl">
            <p class="text-slate-400 text-sm">Tidak ditemukan data inventaris produk.</p>
          </div>
        <% } %>
      </div>
    </div>
  </main>

  <!-- Footer -->
  <footer class="bg-slate-900 text-slate-500 text-xs py-8 border-t border-slate-800 text-center">
    <div class="container mx-auto px-4 space-y-2">
      <p class="text-slate-400 font-medium">&copy; 2026 Toko Seni Gypsum Digital System</p>
      <p>Penyusunan Anggota Tim: Aryarez, Muhammad Naufal, Radiva, Andhika</p>
    </div>
  </footer>

</body>
</html>

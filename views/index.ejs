<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Frontend Dashboard - Week 7</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://tailwindcss.com"></script>
</head>
<body class="bg-gray-100 font-sans antialiased">

    <div class="container mx-auto px-4 py-8 max-w-4xl">
        <!-- Header -->
        <header class="mb-8 text-center md:text-left">
            <h1 class="text-3xl font-bold text-gray-800">📦 Sistem Manajemen Produk</h1>
            <p class="text-gray-600 mt-1">Halaman Frontend Dinamis berbasis Express.js & EJS (Arsitektur MVC)</p>
        </header>

        <!-- Main Content -->
        <main class="bg-white rounded-lg shadow-md p-6">
            <h2 class="text-xl font-semibold text-gray-700 mb-4">Daftar Produk Tersedia (diambil dari Backend)</h2>
            
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="bg-gray-800 text-white">
                            <th class="py-3 px-4 rounded-l-lg">ID</th>
                            <th class="py-3 px-4">Nama Produk</th>
                            <th class="py-3 px-4">Harga</th>
                            <th class="py-3 px-4">Kategori</th>
                            <th class="py-3 px-4 rounded-r-lg">Spesifikasi</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-200">
                        <% produkList.forEach(function(produk) { %>
                            <tr class="hover:bg-gray-50 transition-colors">
                                <td class="py-3 px-4 font-medium text-gray-600"><%= produk.id %></td>
                                <td class="py-3 px-4 text-gray-800 font-semibold"><%= produk.name %></td>
                                <td class="py-3 px-4 text-emerald-600 font-bold">
                                    Rp <%= produk.price.toLocaleString('id-ID') %>
                                </td>
                                <td class="py-3 px-4"><%= produk.category %></td>
                                <td class="py-3 px-4"><%= produk.spec %></td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
        </main>

        <!-- Footer -->
        <footer class="mt-8 text-center text-sm text-gray-500">
            <p>&copy; 2026 Project Kelompok Web Service - All Rights Reserved.</p>
        </footer>
    </div>

</body>
</html>
